{
  "name": "nijaz-showcase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "node scripts/validate-site.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "astro check",
    "format": "prettier --write src scripts tests astro.config.mjs",
    "build:production": "PUBLIC_SITE_LIVE=true astro build"
  },
  "dependencies": {
    "astro": "7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource-variable/golos-text": "5.2.6",
    "@fontsource/manrope": "5.2.6",
    "node": "^24.20.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
