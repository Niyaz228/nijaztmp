---
interface Props {
  footer?: boolean;
}
const { footer = false } = Astro.props;
---

<a
  href="/"
  class:list={['logo', { 'logo-footer': footer }]}
  aria-label="НИЯЗ — главная"
>
  <img src="/images/logo.svg" width="392" height="256" alt="" aria-hidden="true" />
  <span
    >НИЯЗ<span class="logo-caption">ПРОИЗВОДСТВО И БЛАГОУСТРОЙСТВО</span></span
  >
</a>
