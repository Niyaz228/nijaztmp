---
interface Props {
  footer?: boolean;
}
const { footer = false } = Astro.props;
---

<a
  href="/"
  class:list={['logo', { 'logo-footer': footer }]}
  aria-label="НИЯЗ — главная"
>
  <svg viewBox="0 0 38 38" width="38" height="38" aria-hidden="true"
    ><path
      fill="currentColor"
      d="M1 1h16v16H1zm20 0h16v16H21zM1 21h16v16H1zm20 0h16v16H21z"></path></svg
  >
  <span
    >НИЯЗ<span class="logo-caption">ПРОИЗВОДСТВО И БЛАГОУСТРОЙСТВО</span></span
  >
</a>
