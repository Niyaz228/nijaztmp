---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import Gallery from '../components/Gallery.astro';
import ContactBand from '../components/ContactBand.astro';
---

<BaseLayout
  title="Фото продукции и укладки плитки НИЯЗ"
  description="Фотографии продукции НИЯЗ: тротуарная и тактильная плитка, ворота, калитки и ограничители парковки. Производство в Барановичах, работа по всей Беларуси."
  crumbs={[{ name: 'Фото', href: '/photos/' }]}
>
  <PageHeading
    title="Продукция и её применение"
    crumbs={[{ name: 'Фото' }]}
    text="Тротуарная и тактильная плитка, ворота, калитки и ограничители парковки. Готовая продукция, укладка и примеры благоустройства."
  /><section class="container page-section">
    <Gallery filters />
  </section><ContactBand />
</BaseLayout>
